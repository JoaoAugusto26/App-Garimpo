{
  "name": "Garimpo",
  "short_name": "Garimpo",
  "description": "Manda vídeos do Instagram para o Claude garimpar: só fica o que vale a pena.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "pt-BR",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [
    { "src": "icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Colar link",
      "short_name": "Colar link",
      "description": "Abre o Garimpo pronto para colar o link de um vídeo",
      "url": "./?abrir=colar",
      "icons": [{ "src": "icone-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Caixa de ferramentas",
      "short_name": "Ferramentas",
      "description": "As ferramentas que valem a pena, com o comando para instalar",
      "url": "./?abrir=ferramentas",
      "icons": [{ "src": "icone-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Como usar",
      "short_name": "Como usar",
      "description": "O passo a passo do Garimpo",
      "url": "./ajuda.html",
      "icons": [{ "src": "icone-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
